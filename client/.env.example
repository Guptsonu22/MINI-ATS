# =============================================================
# Mini ATS — Client Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# Variables must be prefixed with VITE_ to be exposed to the browser.
# NEVER commit .env to Git. See .gitignore.

# ---- API Base URL ----
# Local development: leave empty — Vite dev server proxies /api → http://localhost:5000
# Production (Vercel): set to your deployed Render backend URL, e.g.:
#   VITE_API_URL=https://mini-ats-api.onrender.com/api
VITE_API_URL=
