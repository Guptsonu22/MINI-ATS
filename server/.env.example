# =============================================================
# Mini ATS — Server Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. See .gitignore.

# ---- Server ----
PORT=5000
NODE_ENV=development   # development | production | test

# ---- MongoDB ----
# Local development: use a local MongoDB instance.
# Production: paste your MongoDB Atlas connection string.
# Atlas format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mini_ats

# Isolated test database — used only during `npm run test`
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/mini_ats_test_runner

# ---- CORS ----
# Development: Vite dev server
# Production: your deployed frontend URL (e.g. https://mini-ats.vercel.app)
CLIENT_ORIGIN=http://localhost:5173
